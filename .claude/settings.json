{
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv sync:*)",
      "Bash(docker compose ps)",
      "Bash(docker compose config --quiet)",
      "Bash(docker compose up:*)",
      "Bash(docker compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git switch -c:*)",
      "Bash(git add:*)",
      "Bash(git commit -m:*)"
    ],
    "ask": [
      "Bash(git merge:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git commit --amend:*)",
      "Bash(git commit * --amend*)",
      "Bash(git add .)",
      "Bash(git add * -f*)",
      "Bash(git add * --force*)",
      "Bash(git add * -A*)",
      "Bash(git add * --all*)",
      "Bash(git add * .env*)",
      "Bash(git add -- .)",
      "Bash(git add ./)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add -u:*)",
      "Bash(git add -f:*)",
      "Bash(git add --force:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -f:*)",
      "Bash(git branch --force:*)",
      "Bash(git switch -C:*)",
      "Bash(git switch -f:*)",
      "Bash(git switch * -f*)",
      "Bash(git switch * --force*)",
      "Bash(git switch * --discard-changes*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose run:*)",
      "Bash(docker compose exec:*)",
      "Read(./.env)",
      "Read(./**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/main_session_guard.py\""
          }
        ]
      }
    ]
  }
}
